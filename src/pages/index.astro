---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers, getCatalogSummary } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
const summary = await getCatalogSummary(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section class="mb-10" aria-labelledby="catalog-summary-heading">
      <h2 id="catalog-summary-heading" class="sr-only">Catalog summary</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-testid="catalog-summary">
        <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-5">
          <p class="text-sm text-slate-400">Games in the catalog</p>
          <p class="mt-1 text-3xl font-semibold text-slate-100" data-testid="catalog-game-count">{summary.gameCount}</p>
        </div>
        <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-5">
          <p class="text-sm text-slate-400">Average star rating</p>
          <p class="mt-1 text-3xl font-semibold text-slate-100" data-testid="catalog-average-rating">
            {summary.averageRating === null ? 'Not yet rated' : `${summary.averageRating.toFixed(1)} / 5`}
          </p>
        </div>
      </div>
    </section>

    <div>
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <form class="grid grid-cols-1 gap-3 sm:grid-cols-2" data-testid="game-filters">
          <div>
            <label for="category-filter" class="mb-1 block text-sm font-medium text-slate-300">Category</label>
            <select id="category-filter" multiple size="3" class="min-w-44 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500" data-testid="category-filter">
              {categories.map((category) => <option value={category.id}>{category.name}</option>)}
            </select>
          </div>
          <div>
            <label for="publisher-filter" class="mb-1 block text-sm font-medium text-slate-300">Publisher</label>
            <select id="publisher-filter" multiple size="3" class="min-w-44 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500" data-testid="publisher-filter">
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
          <button type="reset" class="sm:col-span-2 justify-self-start rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500" data-testid="reset-filters">
            Clear filters
          </button>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <p class="hidden rounded-xl border border-slate-700 bg-slate-800/60 p-6 text-center text-slate-300" data-testid="no-filter-results">
        No games match the selected filters.
      </p>
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resetFilters = document.querySelector<HTMLButtonElement>('[data-testid="reset-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  const selectedValues = (select: HTMLSelectElement | null): string[] =>
    select ? Array.from(select.selectedOptions, (option) => option.value) : [];

  const updateResults = (): void => {
    const categories = selectedValues(categoryFilter);
    const publishers = selectedValues(publisherFilter);
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatches = categories.length === 0 || categories.includes(card.dataset.gameCategoryId ?? '');
      const publisherMatches = publishers.length === 0 || publishers.includes(card.dataset.gamePublisherId ?? '');
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    noResults?.classList.toggle('hidden', visibleCount > 0);
  };

  categoryFilter?.addEventListener('change', updateResults);
  publisherFilter?.addEventListener('change', updateResults);
  resetFilters?.closest('form')?.addEventListener('reset', () => {
    cards.forEach((card) => {
      card.hidden = false;
    });
    noResults?.classList.add('hidden');
  });
</script>
